{
  "name": "vice-maps-roblox",
  "globIgnorePaths": ["**/.DS_Store"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "CityVisual": { "$path": "src/ReplicatedStorage/CityVisual" },
      "Shared": { "$path": "src/ReplicatedStorage/Shared" }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/ServerScriptService"
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 1500
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "ClockTime": 15,
        "GeographicLatitude": 44.81
      }
    }
  }
}
